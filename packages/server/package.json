{
  "name": "@botmesh/server",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "Webhook ingress for @botmesh providers: raw-body capture, size limits, timeouts, a concurrency cap and health endpoints for node:http, Express, Fastify and Hono (no framework dependencies).",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./express": {
      "types": "./lib/adapters/express.d.ts",
      "default": "./lib/adapters/express.js"
    },
    "./fastify": {
      "types": "./lib/adapters/fastify.d.ts",
      "default": "./lib/adapters/fastify.js"
    },
    "./hono": {
      "types": "./lib/adapters/hono.d.ts",
      "default": "./lib/adapters/hono.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "botmesh",
    "bot",
    "chatbot",
    "webhook",
    "ingress",
    "raw-body",
    "health-check",
    "express",
    "fastify",
    "hono"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/server"
  },
  "homepage": "https://andresayac.github.io/botmesh/guide/server",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@botmesh/core": "workspace:^",
    "@botmesh/meta": "workspace:^",
    "@botmesh/telegram": "workspace:^",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "hono": "^4.13.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
