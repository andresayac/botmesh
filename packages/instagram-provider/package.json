{
  "name": "@botmesh/instagram",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "Instagram DM transport for @botmesh/core — Messenger API for Instagram (Meta Graph): signed webhooks, quick replies, typing and read receipts.",
  "main": "lib/index.js", "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./internal": { "types": "./lib/internal.d.ts", "default": "./lib/internal.js" }
  },
  "engines": { "node": ">=22" },
  "keywords": ["botmesh", "instagram", "instagram-dm", "meta", "provider", "transport", "webhook", "chatbot"],
  "author": "Andres Aya", "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/botmesh.git", "directory": "packages/instagram-provider" },
  "homepage": "https://andresayac.github.io/botmesh/guide/channels#botmesh-instagram",
  "bugs": { "url": "https://github.com/andresayac/botmesh/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "prepublishOnly": "pnpm build", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@botmesh/core": "workspace:^", "@botmesh/graph-core": "workspace:^", "@botmesh/http": "workspace:^", "pino": "^10.3.1" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2", "vite": "^7.3.7", "vitest": "^4.1.12" },
  "publishConfig": { "access": "public" }
}
