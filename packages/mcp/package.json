{
  "name": "@botmesh/mcp",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "MCP server (stdio) for botmesh: validates, analyzes, migrates and diffs code-free JSON flow documents and searches the documentation. No network.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "botmesh-mcp": "./lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "botmesh",
    "mcp",
    "model-context-protocol",
    "chatbot",
    "flows"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "dependencies": {
    "@botmesh/core": "workspace:^",
    "@botmesh/flow-schema": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://andresayac.github.io/botmesh/guide/mcp",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
