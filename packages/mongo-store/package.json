{
  "name": "@botmesh/mongo-store",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "MongoDB store for @botmesh/core: shared bot state and durable scheduler on the official mongodb driver.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "botmesh",
    "store",
    "mongodb",
    "mongo",
    "scheduler"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/mongo-store"
  },
  "homepage": "https://botmesh.afaya.com.co/guide/store",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/core": "workspace:^"
  },
  "peerDependencies": {
    "mongodb": "^6.10.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "mongodb": "^7.7.0",
    "mongodb-v6": "npm:mongodb@^6.10.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
