{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/spi.ts", "src/testing/index.ts"],
  "tsconfig": "tsconfig.json",
  "out": "../../docs/api",
  "name": "@botmesh/core",
  "includeVersion": true,
  "readme": "README.md",
  "theme": "default",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "disableSources": false,
  "categorizeByGroup": false,
  "defaultCategory": "Also in @botmesh/core",
  "categoryOrder": [
    "Bot", "Test bot", "MockProvider", "Contract checks", "Chaos testing", "Crash testing",
    "Messages & context", "Triggers", "Flows", "Conversations", "Forms", "Hooks & plugins",
    "Handoff & access lists", "i18n", "Store", "User data", "Scheduler", "Operations", "Errors",
    "Provider", "Durability", "Coordination", "Tracing", "Flow inspection", "Golden transcripts",
    "Dev simulator", "Utilities", "*"
  ],
  "groupOrder": ["Constructors", "Properties", "Methods", "Functions", "Type Aliases", "Interfaces", "Classes", "Enumerations", "*"],
  "sort": ["source-order"],
  "visibilityFilters": {
    "protected": false,
    "private": false,
    "inherited": true,
    "external": false
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "githubPages": true,
  "cleanOutputDir": true
}
