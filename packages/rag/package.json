{
  "name": "@botmesh/rag",
  "version": "0.1.0",
  "type": "module",
  "description": "Retrieval Augmented Generation for @botmesh/ai — document loaders, chunking, pluggable embeddings (OpenAI-compatible, Ollama, local hashing) and an in-memory cosine vector index with optional JSON persistence.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "botmesh",
    "rag",
    "embeddings",
    "retrieval",
    "vector",
    "ai",
    "llm"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/rag"
  },
  "homepage": "https://andresayac.github.io/botmesh/guide/ai-memory-rag#botmesh-rag",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/http": "workspace:^"
  },
  "peerDependencies": {
    "pdf-parse": ">=1.1.1"
  },
  "peerDependenciesMeta": {
    "pdf-parse": {
      "optional": true
    }
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5",
    "@botmesh/ai": "workspace:^",
    "@botmesh/core": "workspace:^",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
