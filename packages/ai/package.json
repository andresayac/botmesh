{
  "name": "@botmesh/ai",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "Multi-provider AI autoresponder plugin for @botmesh/core (Anthropic, OpenAI, Google Gemini, Ollama and OpenAI-compatible presets), with per-chat conversation memory, tools and a ctx.tools.ai client.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bot",
    "baileys",
    "whatsapp",
    "ai",
    "llm",
    "anthropic",
    "claude",
    "openai",
    "gemini",
    "ollama",
    "chatbot",
    "plugin"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/ai"
  },
  "homepage": "https://andresayac.github.io/botmesh/guide/ai",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/core": "workspace:^"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.68.0 || ^1.0.0",
    "@google/genai": "^2.0.0",
    "@google/generative-ai": "^0.21.0 || ^0.22.0 || ^0.23.0 || ^0.24.0",
    "openai": "^6.48.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@botmesh/telegram": "workspace:^",
    "@google/genai": "^2.31.0",
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^26.1.1",
    "anthropic-sdk-v0": "npm:@anthropic-ai/sdk@0.68.0",
    "google-genai-v2-0": "npm:@google/genai@2.0.0",
    "openai": "^7.43.0",
    "openai-v6": "npm:openai@6.48.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": { "access": "public" }
}
