{
  "name": "@botmesh/twilio",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "Twilio transport for @botmesh/core — WhatsApp + SMS over the Programmable Messaging REST API, X-Twilio-Signature webhooks.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "botmesh",
    "twilio",
    "whatsapp",
    "sms",
    "provider",
    "transport"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/twilio-provider"
  },
  "homepage": "https://botmesh.afaya.com.co/guide/channels#@botmesh/twilio",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/core": "workspace:^",
    "@botmesh/http": "workspace:^",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@botmesh/server": "workspace:^",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
