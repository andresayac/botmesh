{
  "name": "@botmesh/evolution",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "Evolution API (self-hosted WhatsApp REST gateway) transport for @botmesh/core — REST outbound + signed webhook ingest.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./internal": { "types": "./lib/internal.d.ts", "default": "./lib/internal.js" }
  },
  "engines": { "node": ">=22" },
  "keywords": ["botmesh", "whatsapp", "evolution-api", "provider", "transport"],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/botmesh.git", "directory": "packages/evolution-provider" },
  "homepage": "https://botmesh.afaya.com.co/guide/evolution",
  "bugs": { "url": "https://github.com/andresayac/botmesh/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "prepublishOnly": "pnpm build", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@botmesh/core": "workspace:^", "@botmesh/http": "workspace:^", "@botmesh/wa-gateway-kit": "workspace:^", "pino": "^10.3.1" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2", "vite": "^7.3.7", "vitest": "^4.1.12" },
  "publishConfig": { "access": "public" }
}
