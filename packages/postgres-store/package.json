{
  "name": "@botmesh/postgres-store",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "PostgreSQL store for @botmesh/core: shared bot state, durable scheduler and durable inbox/outbox on node-postgres.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "botmesh",
    "store",
    "postgres",
    "postgresql",
    "pg",
    "durability",
    "scheduler"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/postgres-store"
  },
  "homepage": "https://botmesh.afaya.com.co/guide/store",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/core": "workspace:^"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
