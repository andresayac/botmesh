{
  "name": "@botmesh/graph-core",
  "version": "0.2.0-alpha.0",
  "type": "module",
  "description": "Shared Meta Graph helpers (webhook verification, typed error mapping, ingest guard) for @botmesh/meta, @botmesh/messenger and @botmesh/instagram.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": ["botmesh", "meta", "graph", "webhook", "whatsapp", "messenger", "instagram"],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/graph-core"
  },
  "homepage": "https://andresayac.github.io/botmesh/guide/channels",
  "bugs": { "url": "https://github.com/andresayac/botmesh/issues" },
  "files": ["./lib/**/*"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "publishConfig": { "access": "public" }
}
