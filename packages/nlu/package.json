{
  "name": "@botmesh/nlu",
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight local intent/NLU for @botmesh/core — define intents with utterances, match incoming text, no external services.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "botmesh",
    "nlu",
    "intent",
    "intents",
    "dialogflow"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/nlu"
  },
  "homepage": "https://andresayac.github.io/botmesh/guide/integrations#local-intent-matching-nlu",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
