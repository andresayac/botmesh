{
  "name": "@botmesh/events",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "Versioned event envelopes, leased journals with fencing tokens, an at-least-once worker with retries and a dead-letter state, and a durability backend for @botmesh/core.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./durability": {
      "types": "./lib/durability.d.ts",
      "default": "./lib/durability.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "botmesh",
    "bot",
    "events",
    "journal",
    "inbox",
    "outbox",
    "idempotency",
    "dlq",
    "fencing",
    "durability"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/events"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@botmesh/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@botmesh/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@botmesh/core": "workspace:^",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "homepage": "https://andresayac.github.io/botmesh/guide/operations#event-processing",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
