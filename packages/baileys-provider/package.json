{
  "name": "@botmesh/baileys",
  "version": "0.2.0-alpha.0",
  "type": "module",
  "description": "WhatsApp transport for @botmesh/core, built on Baileys 7 (IProvider v2).",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bot",
    "baileys",
    "whatsapp",
    "provider",
    "transport",
    "botmesh"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/baileys-provider"
  },
  "homepage": "https://github.com/andresayac/botmesh/tree/main/packages/baileys-provider#readme",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "pnpm run build && tsc -p examples/tsconfig.json && node examples/bot.js",
    "example": "pnpm run start",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/core": "workspace:^",
    "@botmesh/http": "workspace:^",
    "@cacheable/node-cache": "^1.5.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^10.3.1",
    "qr-image": "^3.2.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "peerDependenciesMeta": {
    "ffmpeg-static": {
      "optional": true
    }
  },
  "publishConfig": { "access": "public" }
}
